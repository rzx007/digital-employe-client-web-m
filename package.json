{
  "name": "digital-employe-client-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "dev:server": "cd apps/server && uv run uvicorn src.server:app --reload --port 58000",
    "build:server": "python scripts/build-server.py --clean",
    "build:server:debug": "python scripts/build-server.py --debug"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3",
      "core-js-pure",
      "electron-winstaller",
      "esbuild",
      "msw"
    ]
  }
}
