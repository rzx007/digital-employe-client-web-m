{
  "name": "digital-employe-client-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "dev:client": "turbo dev:app",
    "build:client": "turbo build:app",
    "build:app": "python3 scripts/build-server.py --app && pnpm build:client",
    "build:app:offline": "python3 scripts/build-offline-app.py",
    "build:app:offline:clean": "python3 scripts/build-offline-app.py --clean",
    "build:deb:arm64": "bash scripts/build-deb.sh",
    "build:deb:arm64:offline": "bash scripts/build-deb.sh --offline",
    "build:deb:arm64:offline:clean": "bash scripts/build-deb.sh --offline --clean",
    "dev:server": "cd apps/server && uv run python start.py",
    "build:server": "python3 scripts/build-server.py",
    "build:server:debug": "python3 scripts/build-server.py --debug",
    "build:license-issuer": "python apps/license-issuer/scripts/build-binary.py"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "recharts": "3.8.1"
    },
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3",
      "core-js-pure",
      "electron-winstaller",
      "esbuild",
      "msw"
    ]
  }
}
