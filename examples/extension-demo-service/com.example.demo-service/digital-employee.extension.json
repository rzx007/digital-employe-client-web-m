{
  "id": "com.example.demo-service",
  "version": "1.0.0",
  "displayName": "示例插件（含本地服务）",
  "minHostVersion": "0.0.49",
  "permissions": ["context.read"],
  "ui": {
    "entry": "ui/index.html",
    "title": "示例插件 · 本地服务",
    "width": 800,
    "height": 600
  },
  "service": {
    "command": ["node", "server.mjs"],
    "cwd": "service",
    "port": 0,
    "host": "127.0.0.1",
    "envPortKey": "PORT",
    "ready": {
      "type": "stdout",
      "pattern": "listening on"
    }
  }
}
