{
  "id": "com.example.demo-headless",
  "version": "1.0.0",
  "displayName": "示例插件（后台服务）",
  "minHostVersion": "0.0.49",
  "permissions": ["host.events"],
  "service": {
    "command": ["node", "server.mjs"],
    "cwd": "service",
    "port": 0,
    "host": "127.0.0.1",
    "envPortKey": "PORT",
    "ready": {
      "type": "stdout",
      "pattern": "listening on"
    }
  }
}
