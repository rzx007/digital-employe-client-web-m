# 后端上下文语义压缩（员工+总管）；直连 uvicorn 时可在 shell 设 AGENT_SUMMARIZATION=1
# AGENT_SUMMARIZATION=1

VITE_USE_MOCK_SSE=false
VITE_BACKEND_URL=http://localhost
VITE_BACKEND_PORT=34567
# 开发环境是否走 Vite /actus 代理；false 则直连 VITE_BACKEND_URL:PORT
VITE_USE_ACTUS_PROXY=true

# 宠物语音转写（Finch）；留空 URL 则用代码内默认局域网地址
VITE_FINCH_TRANSCRIPTION_URL = http://192.168.2.125:8082/finch/v1/audio/transcriptions
# Bearer 凭证只放在本地 .env / .env.local，勿提交仓库
VITE_FINCH_TRANSCRIPTION_KEY = <your-key>
# 识别语言，默认 zh
VITE_FINCH_TRANSCRIPTION_LANGUAGE = zh
